# Copy this file to ".env" and fill in your values.

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6JhxlEhDrjnzptUDvw9-WVDTntIK8lW6no7844EfHQ8XQ

# Model used for recommendations. Change it if Google retires/renames a model.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional
DATABASE_PATH=pocketsmart.db
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
